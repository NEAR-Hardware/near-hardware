{
  "manifest_version": 3,
  "name": "NEAR Hardware Wallet",
  "short_name": "NEAR Watch",
  "version": "1.0.0",
  "description": "Your NEAR key lives on a watch. Sites see this wallet in NEAR Connect; you approve every signature on the watch.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "NEAR Hardware Wallet",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["dist/inpage.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["dist/content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "https://rpc.testnet.fastnear.com/*",
    "https://rpc.mainnet.fastnear.com/*",
    "https://api.coingecko.com/*"
  ]
}
